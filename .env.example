# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca commite .env.local (já está no .gitignore) nem estes valores
# preenchidos em nenhum outro lugar — são segredos.
# Descrição completa de cada variável: ver README.md > "Variáveis de ambiente".

# ─── Supabase (Dashboard → Settings → API) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Não usada em nenhum lugar do código hoje (nenhum cliente Supabase roda no
# navegador) — pode ficar em branco sem quebrar nada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Resend (Dashboard → API Keys) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL="VotoOnline <no-reply@seudominio.com>"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
# String longa e aleatória — NUNCA uma senha memorável (assina os tokens de
# sessão). Trocar este valor invalida todas as sessões ativas na hora.
AUTH_PASSWORD=

# ─── App ────────────────────────────────────────────────────────────────────
# Sem barra no final.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Sentry (opcional — monitoramento de erros) ────────────────────────────
# Deixe tudo em branco pra não usar Sentry; nada quebra sem essas variáveis.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
